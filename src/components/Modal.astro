---
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

export interface Props {
  id?: string;
  lang: Lang;
}

const { id = 'contact-modal', lang } = Astro.props;
const t = useTranslations(lang);
---

<modal-dialog data-modal-id={id}>
  <div
    id={`${id}-container`}
    data-state="closed"
    class="fixed inset-0 z-50 pointer-events-none transition-opacity duration-300 opacity-0 flex items-center justify-center p-4 sm:p-6 data-[state=open]:pointer-events-auto data-[state=open]:opacity-100"
    role="dialog"
    aria-modal="true"
    aria-labelledby={`${id}-title`}
    aria-describedby={`${id}-desc`}
    aria-hidden="true"
  >
    <!-- Backdrop -->
    <div
      id={`${id}-backdrop`}
      class="absolute inset-0 bg-slate-950/80 backdrop-blur-sm cursor-pointer"
    ></div>

    <!-- Dialog Card -->
    <div
      id={`${id}-card`}
      data-state="closed"
      class="relative w-full max-w-lg bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl transform scale-95 transition-all duration-300 ease-out data-[state=open]:scale-100"
    >
      <!-- Close Button (Always first focusable interactive element) -->
      <button
        type="button"
        id={`${id}-close`}
        class="absolute top-5 right-5 p-2 text-slate-400 hover:text-white rounded-xl bg-slate-800/50 hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer"
        aria-label={t('modal.close')}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Header -->
      <div class="mb-6 pr-8">
        <h3 id={`${id}-title`} class="text-xl sm:text-2xl font-bold text-white tracking-tight">
          {t('modal.title')}
        </h3>
        <p id={`${id}-desc`} class="mt-2 text-sm text-slate-400">
          {t('modal.subtitle')}
        </p>
      </div>

      <!-- Form View -->
      <form id={`${id}-form`} class="space-y-4">
        <div>
          <label for={`${id}-name`} class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
            {t('modal.name')}
          </label>
          <input
            type="text"
            id={`${id}-name`}
            name="name"
            required
            placeholder={t('modal.name.placeholder')}
            class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors"
          />
        </div>

        <div>
          <label for={`${id}-email`} class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
            {t('modal.email')}
          </label>
          <input
            type="email"
            id={`${id}-email`}
            name="email"
            required
            placeholder={t('modal.email.placeholder')}
            class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors"
          />
        </div>

        <div>
          <label for={`${id}-message`} class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
            {t('modal.message')}
          </label>
          <textarea
            id={`${id}-message`}
            name="message"
            rows="3"
            placeholder={t('modal.message.placeholder')}
            class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors resize-none"
          ></textarea>
        </div>

        <button
          type="submit"
          id={`${id}-submit`}
          class="w-full py-3.5 px-6 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm transition-all duration-200 shadow-lg shadow-blue-600/30 hover:shadow-blue-600/40 active:scale-98 cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-400"
        >
          {t('modal.submit')}
        </button>
      </form>

      <!-- Success Notification View -->
      <div id={`${id}-success`} class="hidden py-8 text-center space-y-4">
        <div class="w-14 h-14 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center mx-auto shadow-lg shadow-emerald-500/10">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h4 class="text-lg font-bold text-white">{t('modal.success')}</h4>
        <button
          type="button"
          class="close-success-btn px-6 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-sm font-medium text-slate-200 transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          {t('modal.close')}
        </button>
      </div>
    </div>
  </div>
</modal-dialog>

<script>
  class ModalDialog extends HTMLElement {
    private modalId: string = 'contact-modal';
    private container: HTMLElement | null = null;
    private card: HTMLElement | null = null;
    private backdrop: HTMLElement | null = null;
    private closeBtn: HTMLElement | null = null;
    private form: HTMLFormElement | null = null;
    private successBox: HTMLElement | null = null;
    private previousActiveElement: HTMLElement | null = null;

    private boundOpenHandler = (e: CustomEvent) => {
      if (e.detail === this.modalId) {
        this.open();
      }
    };
    private boundCloseHandler = () => this.close();
    private boundKeyHandler = (e: KeyboardEvent) => this.handleKeyDown(e);
    private boundTransitionEnd = (e: TransitionEvent) => this.handleTransitionEnd(e);

    private boundGlobalClickHandler = (e: MouseEvent) => {
      const target = (e.target as HTMLElement).closest<HTMLElement>('[data-open-modal]');
      if (target && target.dataset.openModal === this.modalId) {
        e.preventDefault();
        this.open();
      }
    };

    connectedCallback() {
      this.modalId = this.dataset.modalId || 'contact-modal';
      this.container = this.querySelector(`#${this.modalId}-container`);
      this.card = this.querySelector(`#${this.modalId}-card`);
      this.backdrop = this.querySelector(`#${this.modalId}-backdrop`);
      this.closeBtn = this.querySelector(`#${this.modalId}-close`);
      this.form = this.querySelector(`#${this.modalId}-form`);
      this.successBox = this.querySelector(`#${this.modalId}-success`);

      window.addEventListener('open-modal', this.boundOpenHandler as EventListener);
      document.addEventListener('click', this.boundGlobalClickHandler);
      this.closeBtn?.addEventListener('click', this.boundCloseHandler);
      this.backdrop?.addEventListener('click', this.boundCloseHandler);
      this.card?.addEventListener('transitionend', this.boundTransitionEnd);

      const successCloseBtn = this.querySelector('.close-success-btn');
      successCloseBtn?.addEventListener('click', this.boundCloseHandler);

      this.form?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (this.form && this.successBox) {
          this.form.classList.add('hidden');
          this.successBox.classList.remove('hidden');
          requestAnimationFrame(() => {
            const focusables = this.getVisibleFocusableElements();
            if (focusables.length > 0) {
              focusables[0].focus();
            }
          });
        }
      });
    }

    disconnectedCallback() {
      window.removeEventListener('open-modal', this.boundOpenHandler as EventListener);
      document.removeEventListener('click', this.boundGlobalClickHandler);
      this.closeBtn?.removeEventListener('click', this.boundCloseHandler);
      this.backdrop?.removeEventListener('click', this.boundCloseHandler);
      this.card?.removeEventListener('transitionend', this.boundTransitionEnd);
      document.removeEventListener('keydown', this.boundKeyHandler);
    }

    private getVisibleFocusableElements(): HTMLElement[] {
      if (!this.card) return [];
      const focusableSelectors = 'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
      const all = Array.from(this.card.querySelectorAll<HTMLElement>(focusableSelectors));
      return all.filter((el) => {
        // Element is visible and not inside display: none container
        return el.offsetParent !== null && !el.closest('.hidden');
      });
    }

    private handleKeyDown(e: KeyboardEvent) {
      if (this.container?.getAttribute('data-state') !== 'open') return;

      if (e.key === 'Escape') {
        e.preventDefault();
        this.close();
        return;
      }

      if (e.key === 'Tab') {
        const focusables = this.getVisibleFocusableElements();
        if (focusables.length === 0) return;

        const first = focusables[0];
        const last = focusables[focusables.length - 1];

        if (e.shiftKey) {
          if (document.activeElement === first || !this.card?.contains(document.activeElement)) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (document.activeElement === last || !this.card?.contains(document.activeElement)) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    }

    open() {
      if (!this.container || !this.card) return;
      this.previousActiveElement = document.activeElement as HTMLElement | null;

      // Reset form view on open
      if (this.form && this.successBox) {
        this.form.reset();
        this.form.classList.remove('hidden');
        this.successBox.classList.add('hidden');
      }

      this.container.setAttribute('data-state', 'open');
      this.card.setAttribute('data-state', 'open');
      this.container.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      document.addEventListener('keydown', this.boundKeyHandler);

      requestAnimationFrame(() => {
        const firstInput = this.container?.querySelector<HTMLInputElement>('input:not([disabled])');
        if (firstInput && !firstInput.closest('.hidden')) {
          firstInput.focus();
        } else {
          this.closeBtn?.focus();
        }
      });
    }

    close() {
      if (!this.container || !this.card) return;
      this.container.setAttribute('data-state', 'closed');
      this.card.setAttribute('data-state', 'closed');
      this.container.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';

      document.removeEventListener('keydown', this.boundKeyHandler);
    }

    private handleTransitionEnd(e: TransitionEvent) {
      if (e.target !== this.card || e.propertyName !== 'transform') return;

      if (this.container?.getAttribute('data-state') === 'closed') {
        this.previousActiveElement?.focus();
      }
    }
  }

  if (!customElements.get('modal-dialog')) {
    customElements.define('modal-dialog', ModalDialog);
  }
</script>
