---
import { languages, type Lang } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/utils';

export interface Props {
  currentLang: Lang;
}

const { currentLang } = Astro.props;
const currentPath = Astro.url.pathname;
---

<div class="relative inline-flex items-center p-1 bg-slate-900 border border-slate-800 rounded-full text-xs font-medium">
  {
    (Object.keys(languages) as Lang[]).map((lang) => {
      const isActive = lang === currentLang;
      const targetPath = getLocalizedPath(currentPath, lang);
      return (
        <a
          href={targetPath}
          class={`px-2.5 py-1 rounded-full transition-all duration-200 ${
            isActive
              ? 'bg-blue-600 text-white font-semibold shadow-sm shadow-blue-500/20'
              : 'text-slate-400 hover:text-slate-200'
          }`}
          aria-label={`Switch to ${languages[lang]}`}
          aria-current={isActive ? 'true' : undefined}
        >
          {lang.toUpperCase()}
        </a>
      );
    })
  }
</div>
