---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, type Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import LanguageSwitch from '../../components/LanguageSwitch.astro';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<BaseLayout title={`404 — ${t('404.title')}`} description={t('404.desc')} lang={lang} noindex={true}>
  <div class="min-h-screen flex flex-col justify-between p-6 sm:p-10 relative overflow-hidden">
    <!-- Top Bar with Logo & Switcher -->
    <header class="flex items-center justify-between max-w-7xl w-full mx-auto">
      <a href={`/${lang}/`} class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center shadow-lg shadow-blue-500/20">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <span class="text-lg font-bold text-white tracking-tight">FinTech<span class="text-blue-500">Pro</span></span>
      </a>

      <LanguageSwitch currentLang={lang} />
    </header>

    <!-- Center Content -->
    <main class="text-center max-w-lg mx-auto my-auto py-12 relative z-10">
      <div class="inline-block text-8xl sm:text-9xl font-extrabold text-transparent bg-clip-text bg-gradient-to-b from-blue-500 to-indigo-800 font-mono tracking-tighter mb-4">
        404
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold text-white mb-3 tracking-tight">
        {t('404.title')}
      </h1>

      <p class="text-sm sm:text-base text-slate-400 mb-8 leading-relaxed">
        {t('404.desc')}
      </p>

      <a
        href={`/${lang}/`}
        class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm transition-all duration-200 shadow-xl shadow-blue-600/30 hover:shadow-blue-600/40 cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-400"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        {t('404.button')}
      </a>
    </main>

    <!-- Bottom note -->
    <footer class="text-center text-xs text-slate-600 max-w-7xl w-full mx-auto">
      &copy; {new Date().getFullYear()} FinTech Pro. All rights reserved.
    </footer>
  </div>
</BaseLayout>
